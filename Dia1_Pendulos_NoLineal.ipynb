   "execution_count": null,
   "outputs": [],
   "source": "def calcular_cuencas(N=130, ancho=2.2, cx=0.0, cy=0.0,\n                     dt=0.05, tmax=400, b=0.20):\n    xs = np.linspace(cx - ancho, cx + ancho, N)\n    ys = np.linspace(cy - ancho, cy + ancho, N)\n    X, Y = np.meshgrid(xs, ys)\n    S = np.stack([X.ravel(), Y.ravel(), np.zeros(N*N), np.zeros(N*N)])\n    Sf = integrar_rapido(S, dt=dt, tmax=tmax, b=b)\n    return xs, ys, iman_final(Sf).reshape(N, N)\n\ndef dibujar_cuencas(xs, ys, M, titulo=\"\", ax=None):\n    from matplotlib.colors import ListedColormap\n    if ax is None:\n        _, ax = plt.subplots(figsize=(6.2, 6.2))\n    ax.imshow(M, origin=\"lower\", extent=[xs[0], xs[-1], ys[0], ys[-1]],\n              cmap=ListedColormap(COLORES), vmin=-0.5, vmax=2.5,\n              interpolation=\"nearest\")\n    for xm, ym in IMANES:\n        if xs[0] < xm < xs[-1] and ys[0] < ym < ys[-1]:\n            ax.plot(xm, ym, \"o\", ms=10, color=\"white\", mec=\"k\", mew=1.5)\n    ax.set_xlabel(\"x₀\"); ax.set_ylabel(\"y₀\")\n    ax.set_title(titulo, fontsize=10); ax.grid(False)\n    return ax"
