   "source": "print(\"¿Y si refinamos más el paso? ¿En algún momento el mapa se estabiliza?\\n\")\nprint(f\"{'b':>6} | {'dt .05 vs .02':>14} | {'dt .02 vs .01':>14}\")\nprint(\"-\"*42)\nfor b in [0.20, 0.06]:\n    _, _, A = calcular_cuencas(N=55, ancho=1.8, dt=0.05, tmax=450, b=b)\n    _, _, B = calcular_cuencas(N=55, ancho=1.8, dt=0.02, tmax=450, b=b)\n    _, _, C = calcular_cuencas(N=55, ancho=1.8, dt=0.01, tmax=450, b=b)\n    print(f\"{b:6.2f} | {100*(A!=B).mean():13.2f}% | {100*(B!=C).mean():13.2f}%\")"
